---
import type { Post } from '../utils/posts';
import { fmtDate, postUrl, postExcerpt } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const excerpt = postExcerpt(post);
const cover = post.data.cover ?? `${import.meta.env.BASE_URL}covers/default-cover.svg`;
---

<article class="island article-card">
  <div class="article-card-body">
    <h3 class="article-title">
      <a href={postUrl(post)}>{post.data.title}</a>
    </h3>
    <div class="article-meta">
      <span>{fmtDate(post.data.date)}</span>
      <span aria-hidden="true">·</span>
      {
        post.data.tags.map((t) => (
          <span class="tag">{t}</span>
        ))
      }
    </div>
    <p class="article-excerpt">{excerpt}</p>
  </div>
  <div class="article-cover">
    <img src={cover} alt="" loading="lazy" />
  </div>
</article>
