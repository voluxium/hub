---
import type { Post } from '../utils/posts';
import { fmtDate, postUrl, postExcerpt } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const excerpt = postExcerpt(post);
const cover = post.data.cover ?? `${import.meta.env.BASE_URL}default-cover.svg`;
---

<article class="island article-card">
  <div class="article-card-body">
    <h3 class="article-title">
      <a href={postUrl(post)}>{post.data.title}</a>
    </h3>
    <div class="article-meta">
      <span>{fmtDate(post.data.date)}</span>
      <span aria-hidden="true">·</span>
      {
        post.data.tags.map((t) => (
          <span class="tag">{t}</span>
        ))
      }
      {
        post.data.subtags.map((t) => (
          <span class="tag tag-sub">{t}</span>
        ))
      }
    </div>
    <p class="article-excerpt">{excerpt}</p>
  </div>
  <div class="article-cover">
    <img src={cover} alt="" loading="lazy" />
  </div>
</article>

<style>
  .article-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    gap: 18px;
    padding: 20px;
  }

  .article-card-body {
    min-width: 0;
  }

  .article-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 8px;
  }

  .article-title a:hover {
    color: var(--accent-strong);
  }

  .article-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-cover {
    width: 160px;
    height: 100px;
    border-radius: var(--inner-border-radius);
    background: var(--hover);
    overflow: hidden;
    border: 1px solid var(--island-border);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 560px) {
    .article-card {
      grid-template-columns: 1fr;
    }
    .article-cover {
      width: 100%;
      height: 160px;
    }
  }
</style>
