---
import type { Post } from '../utils/posts';
import { postUrl } from '../utils/posts';

interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="article-nav">
      {prev ? (
        <a class="island nav-prev" href={postUrl(prev)}>
          <div class="article-nav-label">Previous Post</div>
          <div class="article-nav-title">{prev.data.title}</div>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="island nav-next" href={postUrl(next)}>
          <div class="article-nav-label">Next Post</div>
          <div class="article-nav-title">{next.data.title}</div>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 40px;
    align-items: stretch;
  }

  .article-nav a,
  .article-nav > span {
    min-height: 78px;
  }

  .article-nav a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 16px 20px;
  }

  .article-nav-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .article-nav-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-nav a:hover .article-nav-title {
    color: var(--accent-strong);
  }

  .article-nav .nav-next {
    text-align: right;
  }
</style>
