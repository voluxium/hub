---
interface Props {
  page: number;
  totalPages: number;
  buildHref: (page: number) => string;
}

const { page, totalPages, buildHref } = Astro.props;

function pageRange(current: number, total: number): (number | '…')[] {
  const out: (number | '…')[] = [];
  const push = (n: number | '…') => out.push(n);
  if (total <= 7) {
    for (let i = 1; i <= total; i++) push(i);
    return out;
  }
  push(1);
  if (current - 2 > 2) push('…');
  for (let i = Math.max(2, current - 2); i <= Math.min(total - 1, current + 2); i++) push(i);
  if (current + 2 < total - 1) push('…');
  if (total > 1) push(total);
  return out;
}

const items = pageRange(page, totalPages);
---

{
  totalPages > 1 && (
    <nav class="pagination">
      <a
        href={page === 1 ? undefined : buildHref(page - 1)}
        class={page === 1 ? 'disabled' : ''}
        aria-label="Previous Page"
      >
        &lt;
      </a>
      {items.map((it) =>
        it === '…' ? (
          <span>…</span>
        ) : (
          <a
            href={buildHref(it)}
            class={it === page ? 'current' : ''}
            aria-current={it === page ? 'page' : undefined}
          >
            {it}
          </a>
        )
      )}
      <a
        href={page === totalPages ? undefined : buildHref(page + 1)}
        class={page === totalPages ? 'disabled' : ''}
        aria-label="Next Page"
      >
        &gt;
      </a>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 28px;
  }

  .pagination a,
  .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--border-radius);
    color: var(--text-soft);
    font-size: 16px;
    font-weight: bold;
    background: var(--hover);
  }

  .pagination a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .pagination .current {
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }

  .pagination .disabled {
    opacity: 0.35;
    pointer-events: none;
  }
</style>
