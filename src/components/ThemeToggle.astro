---
const ICONS = {
  sun: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>',
  moon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>',
  auto: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M21 12H12" fill="currentColor" /></svg>',
};

const modes = [
  { id: 'light', label: '亮色', icon: 'sun' },
  { id: 'dark', label: '暗色', icon: 'moon' },
  { id: 'system', label: '系统', icon: 'auto' },
] as const;
---

<!-- 宽屏：三按钮横排 -->
<div class="theme-toggle" id="theme-toggle" role="group">
  {
    modes.map((m) => (
      <button type="button" data-mode={m.id} aria-pressed="false" title={m.label}>
        <span set:html={ICONS[m.icon]}></span>
      </button>
    ))
  }
</div>

<!-- 窄屏：下拉列表 -->
<div class="theme-dropdown">
  <button type="button" class="theme-dropdown-trigger" aria-haspopup="true" aria-expanded="false" title="主题">
    <span class="td-icon" data-icon-mode="light" set:html={ICONS.sun}></span>
    <span class="td-icon" data-icon-mode="dark" set:html={ICONS.moon}></span>
    <span class="td-icon" data-icon-mode="system" set:html={ICONS.auto}></span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
  </button>
  <div class="theme-dropdown-menu" role="group">
    {
      modes.map((m) => (
        <button type="button" data-mode={m.id} aria-pressed="false">
          <span set:html={ICONS[m.icon]}></span>
          {m.label}
        </button>
      ))
    }
  </div>
</div>
