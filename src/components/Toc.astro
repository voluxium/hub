---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 1 || h.depth === 2);
---

{
  tocItems.length > 0 && (
    <aside class="island toc">
      <p class="toc-title">目录</p>
      <ul>
        {tocItems.map((h) => (
          <li>
            <a href={`#${h.slug}`} class={h.depth === 2 ? 'toc-h2' : ''}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .toc {
    position: sticky;
    top: 80px;
  }

  .toc-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 10px;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 5px 0 5px 10px;
    font-size: 13px;
    color: var(--text-soft);
    border-left: 2px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
    line-height: 1.4;
  }

  .toc a:hover,
  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc .toc-h2 {
    padding-left: 22px;
    font-size: 12.5px;
  }
</style>
