---
import { ClientRouter } from 'astro:transitions';

import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'blog' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}icon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // 首屏前应用主题，避免闪烁
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          if (pref !== 'light' && pref !== 'dark') {
            // 首次访问：按系统偏好初始化，但不保留为「跟随系统」模式
            pref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', pref);
          document.documentElement.setAttribute('data-pref', pref);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script is:inline>
      // 全局交互脚本：主题切换 / 目录
      (function () {
        var root = document.documentElement;

        /* ---------- 主题 ---------- */
        function readThemePreference() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') return stored;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function applyTheme(p) {
          try { localStorage.setItem('theme', p); } catch (e) {}
          root.setAttribute('data-theme', p);
          root.setAttribute('data-pref', p);
          var btn = document.getElementById('theme-toggle');
          if (btn) btn.setAttribute('aria-pressed', p === 'dark' ? 'true' : 'false');
        }
        applyTheme(readThemePreference());

        // ClientRouter 会用新页面的 <html> 属性覆盖根节点，data-theme 会在此阶段丢失。
        // 交换完成后立即从 localStorage 恢复，避免闪回浅色。
        document.addEventListener('astro:after-swap', function () {
          applyTheme(readThemePreference());
        });


        /* ---------- 目录 TOC ---------- */
        function setActiveToc() {
          var links = Array.prototype.slice.call(document.querySelectorAll('.toc a[href^="#"]'));
          if (!links.length) return;
          var targets = links.map(function (l) {
            var id = decodeURIComponent(l.getAttribute('href').slice(1));
            return { link: l, el: document.getElementById(id) };
          }).filter(function (t) { return t.el; });
          if (!targets.length) return;
          var current = targets[0];
          for (var i = 0; i < targets.length; i++) {
            if (targets[i].el.getBoundingClientRect().top - 100 <= 0) current = targets[i];
          }
          for (var j = 0; j < links.length; j++) links[j].classList.remove('active');
          current.link.classList.add('active');
        }

        /* ---------- Nav：下滚隐藏 / 上滚 pin ---------- */
        var navState = { lastY: 0, pinned: true };
        var navRO = null;

        function syncNavH() {
          var nav = document.querySelector('.nav');
          if (nav) root.style.setProperty('--nav-h', nav.offsetHeight + 'px');
        }

        function onNavScroll() {
          var nav = document.querySelector('.nav');
          if (!nav) return;
          var y = Math.max(window.scrollY, 0);
          var dy = y - navState.lastY;

          if (y <= 0) {
            nav.classList.remove('nav-hidden');
            navState.pinned = true;
            navState.lastY = y;
            return;
          }

          // 小幅度滚动先累积，避免触控板/平滑滚动时每次 1–3px 被直接丢弃。
          if (Math.abs(dy) < 6) return;

          if (dy > 0) {
            nav.classList.add('nav-hidden');
            navState.pinned = false;
          } else {
            nav.classList.remove('nav-hidden');
            navState.pinned = true;
          }
          navState.lastY = y;
        }

        if (!window.__navScrollBound) {
          window.__navScrollBound = true;
          window.addEventListener('scroll', onNavScroll, { passive: true });
        }

        /* ---------- 点击委托 ---------- */
        document.addEventListener('click', function (e) {
          // 主题
          var tbtn = e.target.closest('#theme-toggle');
          if (tbtn) {
            var next = (root.getAttribute('data-theme') === 'dark') ? 'light' : 'dark';
            applyTheme(next);
            return;
          }

          // 目录：点击定位（CSS scroll-margin-top）
          var tocLink = e.target.closest('.toc a[href^="#"]');
          if (tocLink) {
            e.preventDefault();
            var id = decodeURIComponent(tocLink.getAttribute('href').slice(1));
            var el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.replaceState(null, '', '#' + id);
            }
            return;
          }
        });

        /* ---------- 页面（重新）加载 ---------- */
        function onContentLoaded() {
          applyTheme(readThemePreference());
          setActiveToc();
          var nav = document.querySelector('.nav');
          if (nav) {
            if (navRO) navRO.disconnect();
            navRO = new ResizeObserver(syncNavH);
            navRO.observe(nav);
            syncNavH();
            nav.classList.remove('nav-hidden');
            navState = { lastY: window.scrollY, pinned: true };
          }
        }
        document.addEventListener('astro:page-load', onContentLoaded);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', onContentLoaded);
        } else {
          onContentLoaded();
        }
      })();
    </script>
  </body>
</html>
