---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { sortedPosts, fmtDate, postSlug } from '../../utils/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import 'katex/dist/katex.min.css';

export const getStaticPaths = (async () => {
  const posts = sortedPosts(await getCollection('posts'));
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      prev: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={`${post.data.title}`}>
  <Toc slot="right-rail" headings={headings} />
  <article class="island article-body">
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span>{fmtDate(post.data.date)}</span>
        <span aria-hidden="true">·</span>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        {post.data.subtags.map((t) => <span class="tag tag-sub">{t}</span>)}
      </div>
    </header>
    <hr class="article-divider" />
    <div class="prose">
      <Content />
    </div>
    <div class="license">
      本文采用
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener license">
        CC-BY-NC-SA 4.0
      </a>
      协议发布
    </div>
  </article>
  <ArticleNav prev={prev} next={next} />
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 18px;
  }

  .article-header h1 {
    font-size: 28px;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .article-header .article-meta {
    margin-bottom: 0;
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 22px 0;
  }

  /* 文章内容岛屿：更宽敞的内边距 */
  .article-body {
    padding: 30px 34px;
  }
</style>

<style is:global>
  /* prose 容器内的元素由 markdown 渲染，没有当前组件的 CID，
     所以这里使用 is:global，但所有规则都通过 .prose 前缀作用域隔离 */
  .prose {
    font-size: 16px;
    line-height: 1.78;
    color: var(--text);
  }

  .prose h1,
  .prose h2,
  .prose h3 {
    line-height: 1.35;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
  }

  .prose :is(h1, h2, h3) {
    scroll-margin-top: 96px;
  }

  .prose h1 {
    font-size: 1.6em;
  }

  .prose h2 {
    font-size: 1.32em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--divider);
  }

  .prose p {
    margin: 0.9em 0;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose blockquote {
    margin: 1em 0;
    padding: 8px 16px;
    border-left: 3px solid var(--accent);
    background: var(--hover);
    color: var(--text-soft);
    border-radius: 6px;
  }

  .prose code:not(pre code) {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--hover);
    font-size: 0.92em;
    font-family: "JetBrains Mono", "Fira Code", Consolas, monospace;
  }

  .prose pre {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 16px 18px;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
    margin: 1.2em 0;
  }

  .prose pre code {
    font-family: "JetBrains Mono", "Fira Code", Consolas, monospace;
  }

  /* Math: centered display equations */
  .prose .katex-display {
    margin: 1.4em 0;
    padding: 2px 0;
  }

  /* Images with caption */
  .prose figure {
    margin: 1.4em 0;
  }

  .prose figure img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    border-radius: 10px;
  }

  .prose figcaption {
    margin-top: 8px;
    text-align: center;
    font-size: 13px;
    font-style: italic;
    color: var(--text-muted);
  }
</style>

<style>
  .license {
    margin-top: 36px;
    padding: 14px 18px;
    border: 1px solid var(--divider);
    border-radius: 12px;
    background: var(--hover);
    font-size: 13px;
    color: var(--text-soft);
    text-align: center;
  }

  .license a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
